{
  "name": "CFSE 演示站（cfse-demo）",
  "tpl": {
    "single": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{POST_TITLE}} — {{SITE_NAME}}</title>\n<meta name=\"description\" content=\"{{SITE_DESC}}\">\n<link rel=\"stylesheet\" href=\"{{SITE_URL}}/wp-content/themes/cfse-demo/style.css\">\n<link rel=\"alternate\" type=\"application/rss+xml\" title=\"{{SITE_NAME}} &raquo; Feed\" href=\"{{SITE_URL}}/feed/\">\n</head>\n<body>\n<header class=\"topbar\">\n  <div class=\"shell topbar-in\">\n    <a class=\"brand\" href=\"{{SITE_URL}}/\"><span class=\"logo-mark\">CF</span><span class=\"brand-text\">{{SITE_NAME}}</span><span class=\"badge\">DEMO</span></a>\n    {{#IF_MENU}}<nav class=\"nav\">{{MENU}}</nav>{{/IF_MENU}}\n    <form class=\"srch\" role=\"search\" action=\"{{SEARCH_ACTION}}\" method=\"get\">\n      <input type=\"search\" name=\"s\" placeholder=\"搜索文档…\" aria-label=\"搜索\">\n    </form>\n  </div>\n</header>\n\n<main class=\"article-wrap\">\n  <div class=\"shell\">\n    <article class=\"article\">\n      <div class=\"crumbs\"><a href=\"{{SITE_URL}}/\">首页</a> <span>/</span> {{POST_CATEGORIES}}</div>\n      <h1 class=\"post-title\">{{POST_TITLE}}</h1>\n      <div class=\"post-meta\">\n        <time>{{POST_DATE}}</time>\n        {{#IF_AUTHOR}}<span class=\"sep\">·</span><a href=\"{{POST_AUTHOR_URL}}\">{{POST_AUTHOR}}</a>{{/IF_AUTHOR}}\n        <span class=\"sep\">·</span><a href=\"#comments\">评论</a>\n      </div>\n      {{#IF_THUMBNAIL}}<figure class=\"hero\"><img src=\"{{POST_THUMBNAIL}}\" alt=\"{{POST_TITLE}}\"></figure>{{/IF_THUMBNAIL}}\n      <div class=\"content\">{{POST_CONTENT}}</div>\n      {{#IF_TAGS}}<div class=\"post-tags\">{{POST_TAGS}}</div>{{/IF_TAGS}}\n    </article>\n\n    <nav class=\"prevnext\">\n      {{#IF_PREV}}<a class=\"prev\" href=\"{{PREV_URL}}\">← {{PREV_TITLE}}</a>{{/IF_PREV}}\n      {{#IF_NEXT}}<a class=\"next\" href=\"{{NEXT_URL}}\">{{NEXT_TITLE}} →</a>{{/IF_NEXT}}\n    </nav>\n\n    <section id=\"comments\" class=\"comments\">\n      <!--CFSE-COMMENTS-START id={{CFSE_POST_ID}}-->{{#IF_COMMENTS}}{{COMMENTS}}{{/IF_COMMENTS}}<!--CFSE-COMMENTS-END-->\n    </section>\n  </div>\n</main>\n\n<footer class=\"foot\">\n  <div class=\"shell foot-grid\">\n    <div class=\"foot-brand\">\n      <span class=\"logo-mark\">CF</span>\n      <strong>{{SITE_NAME}}</strong>\n      <p>{{SITE_DESC}}</p>\n    </div>\n    <div><h4>内容</h4><ul>{{SIDEBAR_CATEGORIES}}</ul></div>\n    <div><h4>归档</h4><ul>{{SIDEBAR_ARCHIVES}}</ul></div>\n    <div><h4>订阅</h4><ul><li><a href=\"{{SITE_URL}}/feed/\">RSS 订阅</a></li>{{#IF_SOCIAL}}{{SOCIAL_LINKS}}{{/IF_SOCIAL}}</ul></div>\n  </div>\n  <div class=\"shell foot-bar\">{{SITE_FOOTER}}</div>\n</footer>\n</body>\n</html>\n",
    "item": "<article class=\"post-card\">\n  <div class=\"card-top\">\n    {{#IF_CATEGORIES}}<span class=\"chip\">{{POST_CATEGORIES}}</span>{{/IF_CATEGORIES}}\n    <time>{{POST_DATE}}</time>\n  </div>\n  <h2><a href=\"{{POST_URL}}\">{{POST_TITLE}}</a></h2>\n  <p class=\"excerpt\">{{POST_EXCERPT}}</p>\n  <div class=\"card-foot\">\n    <a class=\"read\" href=\"{{POST_URL}}\">阅读全文 →</a>\n    <span class=\"cc\">{{COMMENT_COUNT}} 条评论</span>\n  </div>\n</article>\n",
    "pageHome": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{SITE_NAME}} — {{SITE_DESC}}</title>\n<meta name=\"description\" content=\"{{SITE_DESC}}\">\n<link rel=\"stylesheet\" href=\"{{SITE_URL}}/wp-content/themes/cfse-demo/style.css\">\n<link rel=\"alternate\" type=\"application/rss+xml\" title=\"{{SITE_NAME}} &raquo; Feed\" href=\"{{SITE_URL}}/feed/\">\n</head>\n<body>\n<header class=\"topbar\">\n  <div class=\"shell topbar-in\">\n    <a class=\"brand\" href=\"{{SITE_URL}}/\"><span class=\"logo-mark\">CF</span><span class=\"brand-text\">{{SITE_NAME}}</span><span class=\"badge\">DEMO</span></a>\n    {{#IF_MENU}}<nav class=\"nav\">{{MENU}}</nav>{{/IF_MENU}}\n    <form class=\"srch\" role=\"search\" action=\"{{SEARCH_ACTION}}\" method=\"get\">\n      <input type=\"search\" name=\"s\" placeholder=\"搜索文档…\" aria-label=\"搜索\">\n    </form>\n  </div>\n</header>\n\n<section class=\"hero\">\n  <div class=\"shell hero-in\">\n    <p class=\"eyebrow\">WordPress × Cloudflare · 静态化 + 独立 CMS</p>\n    <h1>把 WordPress<br><span class=\"grad\">变成一台静态站生成器</span></h1>\n    <p class=\"lede\">单页静态化进 R2，列表由 D1 实时渲染。既能把现有 WordPress 站一键搬上 Cloudflare，也能脱离 WordPress，用内置 CMS 独立建站。</p>\n    <div class=\"cta\">\n      <a class=\"btn btn-primary\" href=\"{{SITE_URL}}/category/start/\">5 分钟开始 →</a>\n      <a class=\"btn btn-ghost\" href=\"{{SITE_URL}}/category/guide/\">阅读使用指南</a>\n    </div>\n    <dl class=\"stats\">\n      <div><dt>0</dt><dd>需要维护的服务器</dd></div>\n      <div><dt>6 类</dt><dd>可在线切换的页面模板</dd></div>\n      <div><dt>10 万</dt><dd>免费额度 · 请求 / 天</dd></div>\n      <div><dt>2 种</dt><dd>建站路线，同一套内核</dd></div>\n    </dl>\n  </div>\n</section>\n\n<section class=\"section\">\n  <div class=\"shell\">\n    <div class=\"sec-head\">\n      <h2>两条路线，同一套内核</h2>\n      <p>保留 WordPress，或者直接开一个新站。数据层与渲染层是同一套。</p>\n    </div>\n    <div class=\"routes\">\n      <a class=\"route\" href=\"{{SITE_URL}}/category/extend/\">\n        <span class=\"route-no\">01 / PLUGIN</span>\n        <h3>WordPress 插件</h3>\n        <p>保留熟悉的编辑体验。插件负责生成静态单页、同步 D1、上传 R2，还能把现有主题抓成风格包。</p>\n        <span class=\"more\">了解插件 →</span>\n      </a>\n      <a class=\"route\" href=\"{{SITE_URL}}/category/start/\">\n        <span class=\"route-no\">02 / CMS</span>\n        <h3>独立 Worker CMS</h3>\n        <p>不依赖 WordPress。D1 存内容、R2 存单页，后台自带 Markdown 与富文本双编辑器、媒体库与评论审核。</p>\n        <span class=\"more\">部署 CMS →</span>\n      </a>\n    </div>\n  </div>\n</section>\n\n<section class=\"section alt\">\n  <div class=\"shell\">\n    <div class=\"sec-head\">\n      <h2>为什么不是又一个静态插件</h2>\n      <p>纯静态死板、纯动态慢。这套方案把两者拆开，各做各擅长的事。</p>\n    </div>\n    <div class=\"feats\">\n      <div class=\"feat\"><div class=\"ico\">动</div><h3>动静分离</h3><p>文章单页预渲染成 HTML 存 R2，列表、分类、标签、归档由 D1 实时查询，发布即更新。</p></div>\n      <div class=\"feat\"><div class=\"ico\">降</div><h3>三级降级生成</h3><p>内部模板渲染 → 前台抓取 → 硬编码兜底。大批量导出不再因为一次超时整批失败。</p></div>\n      <div class=\"feat\"><div class=\"ico\">肤</div><h3>在线换肤</h3><p>一套风格就是一个目录加一份 tpl.json。后台切换即时生效，内置 14 套风格可直接用。</p></div>\n      <div class=\"feat\"><div class=\"ico\">出</div><h3>多出口发布</h3><p>除了 Cloudflare，还能发到 S3、GitHub、Netlify、Vercel、FTP、WebDAV 或本地目录。</p></div>\n      <div class=\"feat\"><div class=\"ico\">评</div><h3>静态站评论</h3><p>评论写 D1，单页响应时注入。审核后立即显示，不必重建页面；还能回写到 WordPress。</p></div>\n      <div class=\"feat\"><div class=\"ico\">开</div><h3>开放写入口</h3><p>兼容 WordPress REST 写子集与应用密码。Obsidian 插件、脚本、任何 HTTP 客户端都能发文。</p></div>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\" id=\"latest\">\n  <div class=\"shell\">\n    <div class=\"sec-head\">\n      <h2>最新文章</h2>\n      <p>部署记录、功能拆解与使用技巧。</p>\n    </div>\n    <div class=\"post-grid\">{{CONTENT}}</div>\n    <nav class=\"pager\">{{PAGINATION_PREV}}{{PAGINATION_NEXT}}</nav>\n    {{#IF_hasPage}}<p class=\"pageinfo\">第 {{PAGE_NUMBER}} 页 · 共 {{TOTAL_POSTS}} 篇</p>{{/IF_hasPage}}\n  </div>\n</section>\n\n<section class=\"band\">\n  <div class=\"shell band-in\">\n    <div>\n      <h2>现在就把站点搬上 Cloudflare</h2>\n      <p>免费额度足够跑一个个人站。装插件、填三个 ID、点发布。</p>\n    </div>\n    <a class=\"btn btn-light\" href=\"{{SITE_URL}}/category/start/\">查看快速开始</a>\n  </div>\n</section>\n\n<footer class=\"foot\">\n  <div class=\"shell foot-grid\">\n    <div class=\"foot-brand\">\n      <span class=\"logo-mark\">CF</span>\n      <strong>{{SITE_NAME}}</strong>\n      <p>{{SITE_DESC}}</p>\n    </div>\n    <div><h4>内容</h4><ul>{{SIDEBAR_CATEGORIES}}</ul></div>\n    <div><h4>归档</h4><ul>{{SIDEBAR_ARCHIVES}}</ul></div>\n    <div><h4>订阅</h4><ul><li><a href=\"{{SITE_URL}}/feed/\">RSS 订阅</a></li>{{#IF_SOCIAL}}{{SOCIAL_LINKS}}{{/IF_SOCIAL}}</ul></div>\n  </div>\n  <div class=\"shell foot-bar\">{{SITE_FOOTER}}</div>\n</footer>\n</body>\n</html>\n",
