    "pageArchive": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{TITLE}} — {{SITE_NAME}}</title>\n<meta name=\"description\" content=\"{{SITE_DESC}}\">\n<link rel=\"stylesheet\" href=\"{{SITE_URL}}/wp-content/themes/cfse-demo/style.css\">\n<link rel=\"alternate\" type=\"application/rss+xml\" title=\"{{SITE_NAME}} &raquo; Feed\" href=\"{{SITE_URL}}/feed/\">\n</head>\n<body>\n<header class=\"topbar\">\n  <div class=\"shell topbar-in\">\n    <a class=\"brand\" href=\"{{SITE_URL}}/\"><span class=\"logo-mark\">CF</span><span class=\"brand-text\">{{SITE_NAME}}</span><span class=\"badge\">DEMO</span></a>\n    {{#IF_MENU}}<nav class=\"nav\">{{MENU}}</nav>{{/IF_MENU}}\n    <form class=\"srch\" role=\"search\" action=\"{{SEARCH_ACTION}}\" method=\"get\">\n      <input type=\"search\" name=\"s\" placeholder=\"搜索文档…\" aria-label=\"搜索\">\n    </form>\n  </div>\n</header>\n\n<section class=\"page-head\">\n  <div class=\"shell\">\n    <p class=\"eyebrow\">归档</p>\n    <h1>{{TITLE}}</h1>\n    <p class=\"page-sub\">共 {{TOTAL_POSTS}} 篇文章</p>\n  </div>\n</section>\n\n<main class=\"section\">\n  <div class=\"shell\">\n    <div class=\"post-grid\">{{CONTENT}}</div>\n    <nav class=\"pager\">{{PAGINATION_PREV}}{{PAGINATION_NEXT}}</nav>\n    {{#IF_hasPage}}<p class=\"pageinfo\">第 {{PAGE_NUMBER}} 页 · 共 {{TOTAL_POSTS}} 篇</p>{{/IF_hasPage}}\n  </div>\n</main>\n\n<footer class=\"foot\">\n  <div class=\"shell foot-grid\">\n    <div class=\"foot-brand\">\n      <span class=\"logo-mark\">CF</span>\n      <strong>{{SITE_NAME}}</strong>\n      <p>{{SITE_DESC}}</p>\n    </div>\n    <div><h4>内容</h4><ul>{{SIDEBAR_CATEGORIES}}</ul></div>\n    <div><h4>归档</h4><ul>{{SIDEBAR_ARCHIVES}}</ul></div>\n    <div><h4>订阅</h4><ul><li><a href=\"{{SITE_URL}}/feed/\">RSS 订阅</a></li>{{#IF_SOCIAL}}{{SOCIAL_LINKS}}{{/IF_SOCIAL}}</ul></div>\n  </div>\n  <div class=\"shell foot-bar\">{{SITE_FOOTER}}</div>\n</foo